# 复制为 .env.local 或由部署流水线注入；以下均为示例域名，必须替换为正式登记值。
VITE_POWER_PARENT_ORIGIN=https://portal.example.example
VITE_POWER_UNITY_ENTRY_URL=https://unity.example.example/webgl/index.html
VITE_POWER_MANIFEST_URL=https://config.example.example/power/scene-topology-manifest.json
# 架构设计推荐 1280 × 720；最终下限由部署负责人按父页面可用区域确认。
VITE_POWER_MINIMUM_VIEWPORT_WIDTH=1280
VITE_POWER_MINIMUM_VIEWPORT_HEIGHT=720
