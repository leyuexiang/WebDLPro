{
  "name": "power-data-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:release": "node ./scripts/build-release.mjs",
    "validate:manifest": "node ./scripts/validate-scene-topology-manifest.mjs",
    "validate:release-artifact": "node ./scripts/validate-release-artifact.mjs",
    "test:visual": "node ./scripts/compare-visual-baseline.mjs",
    "typecheck": "vue-tsc --build",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "dependencies": {
    "pinia": "^4.0.2",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "jpeg-js": "^0.4.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/tsconfig": "^0.9.1",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.9"
  }
}
